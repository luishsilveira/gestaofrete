{
  // Calculadora de frete: site estático (public/) + API do histórico (src/index.js)
  "name": "gestaofrete",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // Banco PostgreSQL (Aiven) via Hyperdrive. O ID não é segredo: usuário e senha ficam guardados no Cloudflare.
  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "1b439f9434264ddfa7b480e4cbe78be6" }
  ],
  "observability": { "enabled": true },
  // Tarefa agendada a cada 5 minutos: importa os pedidos do Bling (o que também renova o token)
  // e mantém o banco do Aiven ativo.
  "triggers": { "crons": ["*/5 * * * *"] },
  // Mantém as variáveis criadas no painel do Cloudflare a cada publicação pelo GitHub.
  // As credenciais do Bling (BLING_CLIENT_ID e BLING_CLIENT_SECRET) devem ser do tipo Secret.
  "keep_vars": true,
  // AUD da aplicação no Cloudflare Access: o servidor confere o login (src/acesso.js). Não é segredo.
  "vars": { "ACCESS_AUD": "6d654de9767443e51566eea650ad92869779891caa86ac2671667c521b621ca8" }
}
